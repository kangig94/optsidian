{
  "name": "optsidian",
  "version": "0.3.0",
  "description": "LLM-optimized Obsidian CLI wrapper with Codex-style editing tools",
  "type": "module",
  "bin": {
    "optsidian": "./dist/optsidian",
    "optsidian-mcp": "./dist/optsidian-mcp"
  },
  "files": [
    "dist",
    "docs"
  ],
  "scripts": {
    "lint": "eslint src/",
    "lint:fix": "eslint src/ --fix",
    "typecheck": "tsc --noEmit",
    "build": "node scripts/build-bundle.mjs",
    "search:eval:ir-vault": "node scripts/generate-search-eval-ir-dataset.mjs",
    "search:eval": "node --import tsx scripts/search-eval.mjs",
    "retrieval:tune": "node scripts/retrieval-tuning-fixture.mjs",
    "package:release": "node scripts/package-release.mjs",
    "test:slow": "node --import tsx --test test/*.slow.mjs",
    "test": "npm run lint && npm run typecheck && npm run build && node --import tsx --test test/*.test.mjs"
  },
  "engines": {
    "node": ">=24.15.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^25.0.0",
    "esbuild": "^0.28.0",
    "eslint": "^10.6.0",
    "eslint-config-prettier": "^10.1.8",
    "tsx": "^4.22.4",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.62.1"
  },
  "dependencies": {
    "@huggingface/tokenizers": "^0.1.3",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "kiwi-nlp": "^0.23.0",
    "msgpackr": "^2.0.4",
    "onnxruntime-node": "^1.27.0",
    "yaml": "^2.8.3",
    "zod": "^4.3.6"
  },
  "allowScripts": {
    "msgpackr-extract@3.0.4": true,
    "onnxruntime-node@1.27.0": true,
    "esbuild@0.28.1": true
  }
}
